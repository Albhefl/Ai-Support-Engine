# Copia este archivo como .env y coloca tus valores. .env NUNCA se sube al repositorio.
PORT=3000

# Motor generativo (Google Gemini). Clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Modelos de respaldo (separados por coma) si el principal está saturado o no disponible
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Tiempo máximo de espera por respuesta del proveedor (ms)
GEMINI_TIMEOUT_MS=30000
